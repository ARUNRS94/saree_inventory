FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:alpine
# Vercel routes to port 80 unless the PORT env var overrides it.
ENV PORT=80
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.vercel.conf /etc/nginx/templates/default.conf.template
