DATABASE_URL=postgresql+asyncpg://saree_user:saree_pass@localhost:5432/saree_inventory
# Alembic connection. Set this when DATABASE_URL points at a transaction pooler
# (Supabase port 6543, Neon "-pooler"); use the session endpoint on port 5432 here.
DATABASE_URL_SYNC=
# Applies pending migrations on start-up. Set to false if you run alembic yourself.
AUTO_MIGRATE=true
APP_NAME=Inventory Management
SECRET_KEY=change-me-to-a-random-secret-key
JWT_SECRET_KEY=change-me-to-a-jwt-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development

# Google sign-in / sign-up (leave GOOGLE_CLIENT_ID empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_ALLOW_SIGNUP=true
GOOGLE_SIGNUP_ROLE=viewer
GOOGLE_ALLOWED_DOMAINS=

POSTGRES_USER=saree_user
POSTGRES_PASSWORD=saree_pass
POSTGRES_DB=saree_inventory
